# Copie este arquivo para .streamlit/secrets.toml e preencha a chave.
# O secrets.toml é ignorado pelo Git; nunca versione a chave real.
# Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY = "cole-sua-chave-aqui"

# Opcional. Padrão: gemini-3.5-flash-lite (menor custo). Alternativa: gemini-4-hydrogen.
# GEMINI_MODEL = "gemini-3.5-flash-lite"
